
{% comment %}
  MIAORA - Vidéo en lecture automatique
  Shopify OS 2.0
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

{% liquid
  assign s = section.settings
  assign cover = s.poster
  if cover == blank and s.video != blank
    assign cover = s.video.preview_image
  endif
  assign has_video = false
  if s.video != blank or s.external_video != blank
    assign has_video = true
  endif
%}

<section id="miaora-autoplay-{{ section.id }}" class="miaora-auto" style="
  --ma-page: {{ s.section_bg }};
  --ma-bg: {{ s.fallback_bg }};
  --ma-title: {{ s.title_color }};
  --ma-text: {{ s.text_color }};
  --ma-button: {{ s.button_bg }};
  --ma-button-text: {{ s.button_color }};
  --ma-width: {{ s.max_width }}px;
  --ma-height: {{ s.desktop_height }}px;
  --ma-radius: {{ s.desktop_radius }}px;
  --ma-overlay: {{ s.overlay_strength | divided_by: 100.0 }};
  --ma-image-pos: {{ s.image_position }};
  --ma-title-size: {{ s.desktop_title_size }}px;
  --ma-text-size: {{ s.desktop_text_size }}px;
  --ma-button-size: {{ s.button_font_size }}px;
  --ma-button-radius: {{ s.button_radius }}px;
  --ma-text-width: {{ s.text_width }}px;
">
  <div class="ma-container">
    <div class="ma-banner">

      <!-- IMAGE DE COUVERTURE -->
      {% if cover != blank or s.mobile_poster != blank %}
        <picture class="ma-picture">
          {% if s.mobile_poster != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ s.mobile_poster | image_url: width: 700 }} 700w, {{ s.mobile_poster | image_url: width: 1100 }} 1100w"
              sizes="100vw"
            >
          {% endif %}

          {% assign display_cover = cover | default: s.mobile_poster %}

          {{
            display_cover
            | image_url: width: 2200
            | image_tag:
              class: 'ma-poster',
              loading: 'eager',
              widths: '480, 750, 1100, 1500, 1800, 2200',
              sizes: '(min-width: 1400px) 1220px, 100vw',
              alt: s.image_alt
          }}
        </picture>
      {% endif %}

      <!-- VIDÉO AUTOMATIQUE -->
      {% if s.video != blank %}

        {{
          s.video
          | video_tag:
            class: 'ma-background-video',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'auto',
            loading: 'eager',
            image_size: '1600x'
        }}

      {% elsif s.external_video != blank %}

        {% if s.external_video.type == 'youtube' %}
          <iframe
            class="ma-background-iframe"
            title="Vidéo Miaora en arrière-plan"
            tabindex="-1"
            aria-hidden="true"
            src="https://www.youtube-nocookie.com/embed/{{ s.external_video.id }}?autoplay=1&amp;mute=1&amp;loop=1&amp;playlist={{ s.external_video.id }}&amp;controls=0&amp;playsinline=1&amp;rel=0"
            allow="autoplay; encrypted-media"
            loading="eager"
          ></iframe>

        {% elsif s.external_video.type == 'vimeo' %}
          <iframe
            class="ma-background-iframe"
            title="Vidéo Miaora en arrière-plan"
            tabindex="-1"
            aria-hidden="true"
            src="https://player.vimeo.com/video/{{ s.external_video.id }}?background=1&amp;autoplay=1&amp;muted=1&amp;loop=1"
            allow="autoplay; fullscreen"
            loading="eager"
          ></iframe>
        {% endif %}

      {% endif %}

      <!-- FILTRE SOMBRE -->
      <div class="ma-shade" aria-hidden="true"></div>

      <!-- CONTENU -->
      <div class="ma-content">

        {% if s.eyebrow != blank %}
          <p class="ma-eyebrow">
            {{ s.eyebrow | escape }}
          </p>
        {% endif %}

        {% if s.title != blank %}
          <h2 class="ma-title">
            {{ s.title | escape }}
          </h2>
        {% endif %}

        {% if s.description != blank %}
          <div class="ma-description">
            {{ s.description }}
          </div>
        {% endif %}

        {% if has_video and s.show_button and s.button_label != blank %}
          <button
            class="ma-button"
            type="button"
            data-ma-open
          >
            {% if s.show_play_icon %}
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M8 5.8a1 1 0 0 1 1.5-.85l10 6.2a1 1 0 0 1 0 1.7l-10 6.2A1 1 0 0 1 8 18.2V5.8Z"/>
              </svg>
            {% endif %}

            {{ s.button_label | escape }}
          </button>
        {% endif %}

      </div>
    </div>
  </div>

  <!-- FENÊTRE VIDÉO AVEC SON -->
  {% if has_video and s.show_button %}
    <dialog
      class="ma-dialog"
      data-ma-dialog
      aria-label="Vidéo de présentation Miaora"
    >
      <div class="ma-player-box">

        <button
          type="button"
          class="ma-close"
          data-ma-close
          aria-label="Fermer la vidéo"
        >
          &times;
        </button>

        <div class="ma-player">

          {% if s.video != blank %}

            {{
              s.video
              | video_tag:
                class: 'ma-video-full',
                autoplay: false,
                loop: false,
                muted: false,
                controls: true,
                playsinline: true,
                preload: 'none',
                image_size: '1600x'
            }}

          {% elsif s.external_video.type == 'youtube' %}

            <iframe
              title="Vidéo Miaora avec son"
              data-ma-src="https://www.youtube-nocookie.com/embed/{{ s.external_video.id }}?autoplay=1&amp;rel=0&amp;playsinline=1"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
            ></iframe>

          {% elsif s.external_video.type == 'vimeo' %}

            <iframe
              title="Vidéo Miaora avec son"
              data-ma-src="https://player.vimeo.com/video/{{ s.external_video.id }}?autoplay=1"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>

          {% endif %}

        </div>
      </div>
    </dialog>
  {% endif %}
</section>

<style>
  /* SECTION PRINCIPALE */

  #miaora-autoplay-{{ section.id }} {
    background: var(--ma-page);
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Manrope', sans-serif;
  }

  #miaora-autoplay-{{ section.id }} *,
  #miaora-autoplay-{{ section.id }} *::before,
  #miaora-autoplay-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #miaora-autoplay-{{ section.id }} .ma-container {
    max-width: var(--ma-width);
    margin: 0 auto;
  }

  /* BANNIÈRE VIDÉO */

  #miaora-autoplay-{{ section.id }} .ma-banner {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: var(--ma-height);
    padding: 55px 26px;
    border-radius: var(--ma-radius);
    background: var(--ma-bg);
    overflow: hidden;
  }

  /* IMAGE / VIDÉO EN FOND */

  #miaora-autoplay-{{ section.id }} .ma-picture,
  #miaora-autoplay-{{ section.id }} .ma-background-video,
  #miaora-autoplay-{{ section.id }} .ma-background-iframe,
  #miaora-autoplay-{{ section.id }} .ma-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #miaora-autoplay-{{ section.id }} .ma-picture {
    z-index: -3;
    display: block;
  }

  #miaora-autoplay-{{ section.id }} .ma-poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ma-image-pos);
  }

  #miaora-autoplay-{{ section.id }} .ma-background-video {
    z-index: -2;
    display: block;
    object-fit: cover;
    object-position: center center;
    pointer-events: none;
  }

  /* VIDÉO YOUTUBE / VIMEO */

  #miaora-autoplay-{{ section.id }} .ma-background-iframe {
    z-index: -2;
    top: 50%;
    left: 50%;
    width: max(100%, 177.78vh);
    height: max(100%, 56.25vw);
    transform: translate(-50%, -50%);
    border: 0;
    pointer-events: none;
  }

  /* ASSOMBRISSEMENT */

  #miaora-autoplay-{{ section.id }} .ma-shade {
    z-index: -1;
    background: rgba(0, 0, 0, var(--ma-overlay));
    pointer-events: none;
  }

  /* TEXTES CENTRÉS */

  #miaora-autoplay-{{ section.id }} .ma-content {
    max-width: var(--ma-text-width);
    width: 100%;
    text-align: center;
    color: var(--ma-text);
    position: relative;
  }

  #miaora-autoplay-{{ section.id }} .ma-eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--ma-text);
    font-family: 'Manrope', sans-serif;
  }

  /* TITRE MANROPE */

  #miaora-autoplay-{{ section.id }} .ma-title {
    margin: 0 0 15px;
    font-family: 'Manrope', sans-serif !important;
    font-size: var(--ma-title-size);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -.045em;
    color: var(--ma-title);
  }

  /* DESCRIPTION MANROPE */

  #miaora-autoplay-{{ section.id }} .ma-description,
  #miaora-autoplay-{{ section.id }} .ma-description * {
    font-family: 'Manrope', sans-serif !important;
    font-size: var(--ma-text-size);
    line-height: 1.45;
    font-weight: 600;
    color: var(--ma-text);
  }

  #miaora-autoplay-{{ section.id }} .ma-description p {
    margin: 0;
  }

  #miaora-autoplay-{{ section.id }} .ma-description p + p {
    margin-top: 8px;
  }

  /* BOUTON */

  #miaora-autoplay-{{ section.id }} .ma-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    margin-top: 24px;
    padding: 14px 24px;
    border: 0;
    border-radius: var(--ma-button-radius);
    background: var(--ma-button);
    color: var(--ma-button-text);
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: var(--ma-button-size);
    line-height: 1.25;
    cursor: pointer;
    transition: transform .2s, filter .2s;
  }

  #miaora-autoplay-{{ section.id }} .ma-button:hover {
    transform: translateY(-2px);
    filter: brightness(.94);
  }

  #miaora-autoplay-{{ section.id }} .ma-button:focus-visible,
  #miaora-autoplay-{{ section.id }} .ma-close:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* LECTEUR VIDÉO GRAND FORMAT */

  #miaora-autoplay-{{ section.id }} .ma-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    width: min(1100px, calc(100vw - 28px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    border: 0;
    border-radius: 15px;
    background: #000;
    color: #fff;
    overflow: visible;
  }

  #miaora-autoplay-{{ section.id }} .ma-dialog::backdrop {
    background: rgba(0, 0, 0, .86);
  }

  #miaora-autoplay-{{ section.id }} .ma-player-box {
    position: relative;
  }

  #miaora-autoplay-{{ section.id }} .ma-player {
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 15px;
    overflow: hidden;
  }

  #miaora-autoplay-{{ section.id }} .ma-player video,
  #miaora-autoplay-{{ section.id }} .ma-player iframe {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: 0;
  }

  #miaora-autoplay-{{ section.id }} .ma-close {
    position: absolute;
    z-index: 2;
    right: -10px;
    top: -17px;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #111;
    box-shadow: 0 3px 15px #0005;
    font-size: 28px;
    cursor: pointer;
  }

  /* VERSION MOBILE */

  @media (max-width: 749px) {

    #miaora-autoplay-{{ section.id }} {
      padding:
        {{ s.mobile_padding_top }}px
        {{ s.mobile_side_padding }}px
        {{ s.mobile_padding_bottom }}px;
    }

    #miaora-autoplay-{{ section.id }} .ma-banner {
      min-height: {{ s.mobile_height }}px;
      padding: 36px 18px;
      border-radius: {{ s.mobile_radius }}px;
    }

    #miaora-autoplay-{{ section.id }} .ma-poster {
      object-position: {{ s.mobile_image_position }};
    }

    #miaora-autoplay-{{ section.id }} .ma-title {
      font-size: {{ s.mobile_title_size }}px !important;
    }

    #miaora-autoplay-{{ section.id }} .ma-description,
    #miaora-autoplay-{{ section.id }} .ma-description * {
      font-size: {{ s.mobile_text_size }}px;
    }

    #miaora-autoplay-{{ section.id }} .ma-button {
      font-size: {{ s.mobile_button_size }}px;
      margin-top: 18px;
      padding: 13px 16px;
    }

    #miaora-autoplay-{{ section.id }} .ma-close {
      right: -2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #miaora-autoplay-{{ section.id }} .ma-button {
      transition: none;
    }
  }
</style>

<script>
(function () {
  var root = document.getElementById(
    'miaora-autoplay-{{ section.id }}'
  );

  if (!root) return;

  var background = root.querySelector(
    '.ma-background-video'
  );

  var dialog = root.querySelector(
    '[data-ma-dialog]'
  );

  var open = root.querySelector(
    '[data-ma-open]'
  );

  var close = root.querySelector(
    '[data-ma-close]'
  );

  /* LECTURE AUTOMATIQUE */

  if (background) {
    background.muted = true;
    background.defaultMuted = true;

    background.setAttribute('muted', '');
    background.setAttribute('playsinline', '');

    var start = background.play();

    if (start && start.catch) {
      start.catch(function () {});
    }
  }

  if (
    !dialog ||
    !open ||
    typeof dialog.showModal !== 'function'
  ) return;

  var fullVideo = dialog.querySelector('video');
  var iframe = dialog.querySelector('iframe');

  /* OUVRIR LA VIDÉO AVEC SON */

  open.addEventListener('click', function () {

    if (background) {
      background.pause();
    }

    dialog.showModal();

    if (iframe) {
      iframe.src = iframe.getAttribute('data-ma-src');
    }

    if (fullVideo) {
      fullVideo.muted = false;

      var result = fullVideo.play();

      if (result && result.catch) {
        result.catch(function () {});
      }
    }
  });

  /* FERMER LA VIDÉO */

  if (close) {
    close.addEventListener('click', function () {
      dialog.close();
    });
  }

  dialog.addEventListener('click', function (e) {
    if (e.target === dialog) {
      dialog.close();
    }
  });

  /* REPRISE DE LA VIDÉO AUTOMATIQUE */

  dialog.addEventListener('close', function () {

    if (fullVideo) {
      fullVideo.pause();
      fullVideo.currentTime = 0;
    }

    if (iframe) {
      iframe.removeAttribute('src');
    }

    if (background) {
      var resumed = background.play();

      if (resumed && resumed.catch) {
        resumed.catch(function () {});
      }
    }

    open.focus();
  });

})();
</script>

{% schema %}
{
  "name": "Miaora vidéo auto",
  "settings": [
    {
      "type": "header",
      "content": "Vidéo (lecture automatique)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo Shopify (recommandé)"
    },
    {
      "type": "video_url",
      "id": "external_video",
      "label": "Ou vidéo YouTube / Vimeo",
      "accept": ["youtube", "vimeo"],
      "info": "Utilisée si aucune vidéo Shopify n'est choisie."
    },
    {
      "type": "paragraph",
      "content": "La vidéo démarre automatiquement, en boucle et sans son. Le bouton permet de regarder avec le son."
    },
    {
      "type": "header",
      "content": "Image de secours"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Couverture ordinateur (facultatif)"
    },
    {
      "type": "image_picker",
      "id": "mobile_poster",
      "label": "Couverture mobile (facultatif)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l'image",
      "default": "Litière autonettoyante Miaora connectée"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de la couverture PC",
      "default": "center center",
      "options": [
        {"value": "center center", "label": "Centre"},
        {"value": "center top", "label": "Haut"},
        {"value": "center bottom", "label": "Bas"},
        {"value": "left center", "label": "Gauche"},
        {"value": "right center", "label": "Droite"}
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Position de la couverture mobile",
      "default": "center center",
      "options": [
        {"value": "center center", "label": "Centre"},
        {"value": "center top", "label": "Haut"},
        {"value": "center bottom", "label": "Bas"},
        {"value": "left center", "label": "Gauche"},
        {"value": "right center", "label": "Droite"}
      ]
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Assombrissement vidéo",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Contenu Manrope"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit texte au-dessus (facultatif)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Fini les corvées de litière"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Découvrez comment Miaora simplifie votre quotidien et le confort de votre chat.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Afficher le bouton avec son",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "VOIR LA VIDÉO AVEC LE SON"
    },
    {
      "type": "checkbox",
      "id": "show_play_icon",
      "label": "Afficher l'icône lecture",
      "default": false
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Fond extérieur",
      "default": "#FAF7F3"
    },
    {
      "type": "color",
      "id": "fallback_bg",
      "label": "Fond sans vidéo",
      "default": "#656F74"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titre",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fond du bouton",
      "default": "#FAF7F3"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Texte du bouton",
      "default": "#1B1B1B"
    },
    {
      "type": "header",
      "content": "Ordinateur"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1220
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Largeur zone texte",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Hauteur bannière",
      "min": 260,
      "max": 740,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "desktop_radius",
      "label": "Coins arrondis",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_title_size",
      "label": "Taille titre",
      "min": 26,
      "max": 70,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "label": "Taille description",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Taille texte bouton",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Arrondi du bouton",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge extérieure haute",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge extérieure basse",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_height",
