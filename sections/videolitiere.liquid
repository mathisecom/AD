
{% comment %}
  MIAORA - Bannière vidéo immersive
  Shopify OS 2.0
  Fichier : sections/miaora-video-immersive.liquid
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

{% liquid
  assign s = section.settings
  assign cover = s.poster | default: s.video.preview_image
  assign has_video = false
  if s.video != blank or s.external_video != blank
    assign has_video = true
  endif
%}

<section id="miaora-video-{{ section.id }}" class="miv" style="
  --miv-bg: {{ s.section_color }};
  --miv-fallback: {{ s.banner_color }};
  --miv-title: {{ s.title_color }};
  --miv-text: {{ s.text_color }};
  --miv-button-bg: {{ s.button_bg }};
  --miv-button-text: {{ s.button_text }};
  --miv-width: {{ s.max_width }}px;
  --miv-text-width: {{ s.text_width }}px;
  --miv-height: {{ s.desktop_height }}px;
  --miv-radius: {{ s.desktop_radius }}px;
  --miv-image-position: {{ s.desktop_image_position }};
  --miv-title-size: {{ s.desktop_title_size }}px;
  --miv-subtitle-size: {{ s.desktop_text_size }}px;
  --miv-button-radius: {{ s.button_radius }}px;
  --miv-button-size: {{ s.button_font_size }}px;
  --miv-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
">

  <div class="miv__container">
    <div class="miv__banner">

      {% if cover != blank %}
        <picture class="miv__picture">
          {% if s.mobile_poster != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ s.mobile_poster | image_url: width: 480 }} 480w,
                {{ s.mobile_poster | image_url: width: 750 }} 750w,
                {{ s.mobile_poster | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {% endif %}

          {{
            cover
            | image_url: width: 2200
            | image_tag:
              class: 'miv__image',
              loading: 'lazy',
              widths: '480, 750, 1100, 1500, 1800, 2200',
              sizes: '(min-width: 1400px) 1220px, 100vw',
              alt: s.image_alt
          }}
        </picture>

      {% elsif s.mobile_poster != blank %}
        {{
          s.mobile_poster
          | image_url: width: 1200
          | image_tag:
            class: 'miv__image',
            loading: 'lazy',
            alt: s.image_alt
        }}

      {% else %}
        <div class="miv__placeholder" aria-hidden="true">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="miv__shade" aria-hidden="true"></div>

      <!-- CONTENU -->
      <div class="miv__content">

        {% if s.eyebrow != blank %}
          <p class="miv__eyebrow">
            {{ s.eyebrow | escape }}
          </p>
        {% endif %}

        {% if s.title != blank %}
          <h2 class="miv__title">
            {{ s.title | escape }}
          </h2>
        {% endif %}

        {% if s.description != blank %}
          <div class="miv__description">
            {{ s.description }}
          </div>
        {% endif %}

        {% if s.button_label != blank %}
          <button
            type="button"
            class="miv__button"
            data-miv-open
            {% unless has_video %}
              disabled
              title="Ajoutez une vidéo dans les réglages"
            {% endunless %}
          >
            {% if s.show_play_icon %}
              <svg
                viewBox="0 0 24 24"
                width="17"
                height="17"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d="M8 5.7a1 1 0 0 1 1.5-.86l10 6.3a1 1 0 0 1 0 1.72l-10 6.3A1 1 0 0 1 8 18.3V5.7Z"/>
              </svg>
            {% endif %}
            <span>{{ s.button_label | escape }}</span>
          </button>
        {% endif %}

      </div>
    </div>
  </div>

  <!-- LECTEUR VIDÉO -->
  {% if has_video %}
    <dialog
      class="miv__dialog"
      aria-label="Vidéo de présentation Miaora"
      data-miv-dialog
    >
      <div class="miv__player-wrap">

        <button
          type="button"
          class="miv__close"
          data-miv-close
          aria-label="Fermer la vidéo"
        >&times;</button>

        <div class="miv__player">

          {% if s.video != blank %}
            {{
              s.video
              | video_tag:
                class: 'miv__video',
                controls: true,
                autoplay: false,
                muted: false,
                loop: false,
                playsinline: true,
                preload: 'none',
                image_size: '1400x'
            }}

          {% elsif s.external_video.type == 'youtube' %}
            <iframe
              title="Vidéo Miaora"
              data-miv-src="https://www.youtube-nocookie.com/embed/{{ s.external_video.id }}?autoplay=1&amp;rel=0&amp;playsinline=1"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
            ></iframe>

          {% elsif s.external_video.type == 'vimeo' %}
            <iframe
              title="Vidéo Miaora"
              data-miv-src="https://player.vimeo.com/video/{{ s.external_video.id }}?autoplay=1"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          {% endif %}

        </div>
      </div>
    </dialog>
  {% endif %}

</section>

<style>
  /* SECTION PRINCIPALE */

  #miaora-video-{{ section.id }} {
    background: var(--miv-bg);
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Manrope', sans-serif;
  }

  #miaora-video-{{ section.id }} *,
  #miaora-video-{{ section.id }} *::before,
  #miaora-video-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #miaora-video-{{ section.id }} .miv__container {
    max-width: var(--miv-width);
    margin-inline: auto;
  }

  /* BANNIÈRE */

  #miaora-video-{{ section.id }} .miv__banner {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: var(--miv-height);
    padding: 60px 28px;
    overflow: hidden;
    border-radius: var(--miv-radius);
    background: var(--miv-fallback);
  }

  /* IMAGE DE COUVERTURE */

  #miaora-video-{{ section.id }} .miv__picture,
  #miaora-video-{{ section.id }} .miv__image,
  #miaora-video-{{ section.id }} .miv__placeholder,
  #miaora-video-{{ section.id }} .miv__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #miaora-video-{{ section.id }} .miv__picture {
    display: block;
    z-index: -2;
  }

  #miaora-video-{{ section.id }} .miv__image {
    object-fit: cover;
    object-position: var(--miv-image-position);
    z-index: -2;
  }

  #miaora-video-{{ section.id }} .miv__placeholder {
    z-index: -2;
    overflow: hidden;
    opacity: .32;
  }

  #miaora-video-{{ section.id }} .miv__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* FILTRE SOMBRE */

  #miaora-video-{{ section.id }} .miv__shade {
    z-index: -1;
    background: rgba(0, 0, 0, var(--miv-overlay));
  }

  /* CONTENU CENTRÉ */

  #miaora-video-{{ section.id }} .miv__content {
    position: relative;
    width: 100%;
    max-width: var(--miv-text-width);
    text-align: center;
    color: var(--miv-text);
  }

  #miaora-video-{{ section.id }} .miv__eyebrow {
    margin: 0 0 12px;
    color: var(--miv-text);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  /* TITRE MANROPE */

  #miaora-video-{{ section.id }} .miv__title {
    font-family: 'Manrope', sans-serif !important;
    color: var(--miv-title);
    margin: 0 0 14px;
    font-size: var(--miv-title-size);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -.045em;
  }

  /* DESCRIPTION MANROPE */

  #miaora-video-{{ section.id }} .miv__description,
  #miaora-video-{{ section.id }} .miv__description * {
    font-family: 'Manrope', sans-serif !important;
    font-size: var(--miv-subtitle-size);
    font-weight: 600;
    line-height: 1.4;
    color: var(--miv-text);
  }

  #miaora-video-{{ section.id }} .miv__description p {
    margin: 0;
  }

  #miaora-video-{{ section.id }} .miv__description p + p {
    margin-top: 8px;
  }

  /* BOUTON */

  #miaora-video-{{ section.id }} .miv__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
    padding: 16px 26px;
    min-height: 49px;
    max-width: 100%;
    background: var(--miv-button-bg);
    color: var(--miv-button-text);
    border: none;
    border-radius: var(--miv-button-radius);
    font-family: 'Manrope', sans-serif !important;
    font-size: var(--miv-button-size);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    cursor: pointer;
    transition: transform .2s ease, filter .2s ease;
  }

  #miaora-video-{{ section.id }} .miv__button:hover:not(:disabled) {
    transform: translateY(-2px);
    filter: brightness(.96);
  }

  #miaora-video-{{ section.id }} .miv__button:disabled {
    opacity: .65;
    cursor: not-allowed;
  }

  #miaora-video-{{ section.id }} .miv__button:focus-visible,
  #miaora-video-{{ section.id }} .miv__close:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* LECTEUR VIDÉO EN MODALE */

  #miaora-video-{{ section.id }} .miv__dialog {
    position: fixed;
    inset: 0;
    width: min(1100px, calc(100% - 30px));
    max-width: none;
    max-height: calc(100% - 30px);
    padding: 0;
    margin: auto;
    overflow: visible;
    border: 0;
    border-radius: 14px;
    background: #000;
    color: #fff;
  }

  #miaora-video-{{ section.id }} .miv__dialog::backdrop {
    background: rgba(0, 0, 0, .84);
  }

  #miaora-video-{{ section.id }} .miv__player-wrap {
    position: relative;
  }

  #miaora-video-{{ section.id }} .miv__player {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: #000;
  }

  #miaora-video-{{ section.id }} .miv__player video,
  #miaora-video-{{ section.id }} .miv__player iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
  }

  #miaora-video-{{ section.id }} .miv__close {
    position: absolute;
    z-index: 2;
    top: -18px;
    right: -12px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #111;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 16px rgba(0,0,0,.25);
  }

  /* RESPONSIVE MOBILE */

  @media (max-width: 749px) {

    #miaora-video-{{ section.id }} {
      padding:
        {{ s.mobile_padding_top }}px
        {{ s.mobile_side_padding }}px
        {{ s.mobile_padding_bottom }}px;
    }

    #miaora-video-{{ section.id }} .miv__banner {
      min-height: {{ s.mobile_height }}px;
      padding: 38px 18px;
      border-radius: {{ s.mobile_radius }}px;
    }

    #miaora-video-{{ section.id }} .miv__image {
      object-position: {{ s.mobile_image_position }};
    }

    #miaora-video-{{ section.id }} .miv__title {
      font-size: {{ s.mobile_title_size }}px;
      margin-bottom: 12px;
      line-height: 1.18;
    }

    #miaora-video-{{ section.id }} .miv__description,
    #miaora-video-{{ section.id }} .miv__description * {
      font-size: {{ s.mobile_text_size }}px;
    }

    #miaora-video-{{ section.id }} .miv__button {
      font-size: {{ s.mobile_button_size }}px;
      padding: 14px 18px;
      margin-top: 20px;
    }

    #miaora-video-{{ section.id }} .miv__dialog {
      width: calc(100% - 18px);
    }

    #miaora-video-{{ section.id }} .miv__close {
      top: -16px;
      right: -3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #miaora-video-{{ section.id }} .miv__button {
      transition: none;
    }
  }
</style>

<script>
(function () {
  var root = document.getElementById('miaora-video-{{ section.id }}');
  if (!root) return;

  var opener = root.querySelector('[data-miv-open]');
  var modal = root.querySelector('[data-miv-dialog]');
  if (!opener || !modal || !modal.showModal) return;

  var closer = root.querySelector('[data-miv-close]');
  var video = modal.querySelector('video');
  var iframe = modal.querySelector('iframe');

  opener.addEventListener('click', function () {
    modal.showModal();

    if (iframe) {
      iframe.src = iframe.getAttribute('data-miv-src');
    }

    if (video) {
      var result = video.play();
      if (result && typeof result.catch === 'function') {
        result.catch(function () {});
      }
    }
  });

  if (closer) {
    closer.addEventListener('click', function () {
      modal.close();
    });
  }

  modal.addEventListener('click', function (event) {
    if (event.target === modal) {
      modal.close();
    }
  });

  modal.addEventListener('close', function () {
    if (video) video.pause();
    if (iframe) iframe.removeAttribute('src');
    opener.focus();
  });
})();
</script>

{% schema %}
{
  "name": "Miaora - Vidéo immersive",
  "settings": [
    {
      "type": "header",
      "content": "Vidéo à lire"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo Shopify (prioritaire)"
    },
    {
      "type": "video_url",
      "id": "external_video",
      "label": "Ou lien YouTube / Vimeo",
      "accept": ["youtube", "vimeo"],
      "info": "Utilisé seulement si aucune vidéo Shopify n'est choisie."
    },

    {
      "type": "header",
      "content": "Image de couverture"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Photo de couverture PC",
      "info": "Si vide, miniature automatique de la vidéo Shopify."
    },
    {
      "type": "image_picker",
      "id": "mobile_poster",
      "label": "Photo de couverture mobile (facultatif)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif de la photo",
      "default": "Présentation de la litière autonettoyante Miaora"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Cadrage photo PC",
      "default": "center center",
      "options": [
        {"value": "center center", "label": "Centre"},
        {"value": "left center", "label": "Gauche"},
        {"value": "right center", "label": "Droite"},
        {"value": "center top", "label": "Haut"},
        {"value": "center bottom", "label": "Bas"}
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Cadrage photo mobile",
      "default": "center center",
      "options": [
        {"value": "center center", "label": "Centre"},
        {"value": "left center", "label": "Gauche"},
        {"value": "right center", "label": "Droite"},
        {"value": "center top", "label": "Haut"},
        {"value": "center bottom", "label": "Bas"}
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Assombrir la photo",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },

    {
      "type": "header",
      "content": "Contenu - Manrope"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit texte au-dessus (facultatif)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Fini les corvées de litière"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Découvrez comment Miaora vous facilite le quotidien et prend soin du confort de votre chat.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "VOIR LA VIDÉO COMPLÈTE"
    },
    {
      "type": "checkbox",
      "id": "show_play_icon",
      "label": "Afficher l'icône lecture",
      "default": false
    },

    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "section_color",
      "label": "Fond extérieur",
      "default": "#FAF7F3"
    },
    {
      "type": "color",
      "id": "banner_color",
      "label": "Fond sans image",
      "default": "#6D7375"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur de la description",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fond du bouton",
      "default": "#FAF7F3"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Texte du bouton",
      "default": "#1B1B1B"
    },

    {
      "type": "header",
      "content": "Ordinateur"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1220
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Largeur zone de texte",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Hauteur bannière PC",
      "min": 260,
      "max": 740,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "desktop_radius",
      "label": "Coins arrondis PC",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_title_size",
      "label": "Taille titre PC",
      "min": 26,
      "max": 70,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "label": "Taille description PC",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Taille texte bouton PC",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Arrondi du bouton",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement supérieur PC",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement inférieur PC",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Hauteur bannière mobile",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "mobile_radius",
      "label": "Coins arrondis mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Taille titre mobile",
      "min": 22,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Taille description mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "label": "Taille texte bouton mobile",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Marges latérales mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Espacement supérieur mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Espacement inférieur mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Miaora - Vidéo immersive"
    }
  ]
}
{% endschema %}