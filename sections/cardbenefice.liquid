
{% comment %}
  Miaora – Carrousel des avantages | Shopify OS 2.0
  Ajouter dans : sections/miaora-avantages-slider.liquid
  Les images doivent être choisies dans l'éditeur Shopify.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

{% assign s = section.settings %}

<section
  id="miaora-benefits-{{ section.id }}"
  class="miaora-benefits"
  style="
    --mi-background: {{ s.section_background }};
    --mi-card-background: {{ s.card_background }};
    --mi-title-color: {{ s.title_color }};
    --mi-text-color: {{ s.text_color }};
    --mi-arrow-background: {{ s.arrow_background }};
    --mi-arrow-color: {{ s.arrow_color }};
    --mi-accent: {{ s.accent_color }};
    --mi-max-width: {{ s.max_width }}px;
    --mi-gap: {{ s.gap_desktop }}px;
    --mi-mobile-gap: {{ s.gap_mobile }}px;
    --mi-radius: {{ s.card_radius }}px;
    --mi-image-ratio: {{ s.image_ratio }};
    --mi-heading-size: {{ s.heading_size }}px;
    --mi-card-title-size: {{ s.card_title_size }}px;
    --mi-card-text-size: {{ s.card_text_size }}px;
    --mi-mobile-title-size: {{ s.mobile_title_size }}px;
    --mi-mobile-text-size: {{ s.mobile_text_size }}px;
    --mi-mobile-width: {{ s.mobile_card_width }}%;
    --mi-content-padding: {{ s.content_padding }}px;
  "
>
  <div class="miaora-benefits__container">

    {% if s.heading != blank or s.show_arrows %}
      <div class="miaora-benefits__header">
        {% if s.heading != blank %}
          <h2 class="miaora-benefits__heading">{{ s.heading | escape }}</h2>
        {% endif %}

        {% if s.show_arrows %}
          <div class="miaora-benefits__arrows" aria-label="Navigation du carrousel">
            <button type="button" class="miaora-benefits__arrow" data-mi-prev aria-label="Voir les avantages précédents">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 18-6-6 6-6"/></svg>
            </button>
            <button type="button" class="miaora-benefits__arrow" data-mi-next aria-label="Voir les avantages suivants">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 18 6-6-6-6"/></svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="miaora-benefits__track"
      data-mi-track
      tabindex="0"
      role="region"
      aria-roledescription="carrousel"
      aria-label="Les avantages de Miaora"
    >
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <article class="miaora-benefits__card" {{ block.shopify_attributes }}>
            <div class="miaora-benefits__media">
              {% if block.settings.image != blank %}
                {% assign image_alt = block.settings.image.alt | default: block.settings.title %}
                <picture>
                  {% if block.settings.mobile_image != blank %}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ block.settings.mobile_image | image_url: width: 420 }} 420w, {{ block.settings.mobile_image | image_url: width: 720 }} 720w, {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w"
                      sizes="85vw"
                    >
                  {% endif %}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'miaora-benefits__image', loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw', alt: image_alt }}
                </picture>
              {% else %}
                <div class="miaora-benefits__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'miaora-benefits__placeholder-svg' }}
                  <span>Ajoutez une image Miaora</span>
                </div>
              {% endif %}
            </div>

            <div class="miaora-benefits__body">
              {% if block.settings.title != blank %}
                <h3 class="miaora-benefits__card-title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="miaora-benefits__card-text">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if s.show_dots %}
      <div class="miaora-benefits__dots" data-mi-dots aria-label="Pages du carrousel"></div>
    {% endif %}
  </div>
</section>

<style>
  #miaora-benefits-{{ section.id }} {
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    background: var(--mi-background);
    font-family: 'Manrope', Arial, sans-serif;
  }
  #miaora-benefits-{{ section.id }} *,
  #miaora-benefits-{{ section.id }} *::before,
  #miaora-benefits-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #miaora-benefits-{{ section.id }} .miaora-benefits__container {
    max-width: var(--mi-max-width);
    margin: 0 auto;
    min-width: 0;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__heading {
    margin: 0;
    font-family: 'Manrope', Arial, sans-serif;
    font-size: var(--mi-heading-size);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -.035em;
    color: var(--mi-title-color);
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__arrows {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-left: auto;
    flex-shrink: 0;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: var(--mi-arrow-background);
    color: var(--mi-arrow-color);
    cursor: pointer;
    transition: opacity .2s ease, transform .2s ease;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__arrow:not(:disabled):hover {
    transform: scale(1.06);
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__arrow:disabled {
    opacity: .3;
    cursor: not-allowed;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__arrow:focus-visible,
  #miaora-benefits-{{ section.id }} .miaora-benefits__dot:focus-visible {
    outline: 2px solid var(--mi-accent);
    outline-offset: 3px;
  }

  /* Carrousel horizontal sur ordinateur, tablette et mobile */
  #miaora-benefits-{{ section.id }} .miaora-benefits__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--mi-gap)) / 3);
    gap: var(--mi-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__track::-webkit-scrollbar {
    display: none;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__card {
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    border-radius: var(--mi-radius);
    background: var(--mi-card-background);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__media {
    width: 100%;
    aspect-ratio: var(--mi-image-ratio);
    overflow: hidden;
    background: #e8e8e8;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ s.image_fit }};
    object-position: center center;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 100%;
    padding: 12px;
    color: #777;
    font-size: 12px;
    text-align: center;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__placeholder-svg {
    width: 75px;
    height: 75px;
    max-width: 40%;
    opacity: .6;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__body {
    flex: 1;
    padding: var(--mi-content-padding);
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__card-title {
    margin: 0 0 10px;
    color: var(--mi-title-color);
    font-family: 'Manrope', Arial, sans-serif;
    font-weight: 800;
    font-size: var(--mi-card-title-size);
    line-height: 1.35;
    letter-spacing: -.025em;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__card-text,
  #miaora-benefits-{{ section.id }} .miaora-benefits__card-text * {
    color: var(--mi-text-color);
    font-family: 'Manrope', Arial, sans-serif;
    font-size: var(--mi-card-text-size);
    line-height: 1.48;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__card-text p {
    margin: 0;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__card-text p + p {
    margin-top: 9px;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__card-text strong {
    font-weight: 800;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__dot {
    display: block;
    width: 8px;
    height: 8px;
    border: 0;
    border-radius: 99px;
    padding: 0;
    background: var(--mi-text-color);
    opacity: .25;
    cursor: pointer;
    transition: width .2s ease, opacity .2s ease;
  }
  #miaora-benefits-{{ section.id }} .miaora-benefits__dot[aria-current="true"] {
    width: 24px;
    opacity: 1;
    background: var(--mi-accent);
  }

  @media (max-width: 989px) {
    #miaora-benefits-{{ section.id }} .miaora-benefits__track {
      grid-auto-columns: calc((100% - var(--mi-gap)) / 2);
    }
  }
  @media (max-width: 749px) {
    #miaora-benefits-{{ section.id }} {
      padding: {{ s.mobile_padding_top }}px {{ s.mobile_side_padding }}px {{ s.mobile_padding_bottom }}px;
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__header {
      margin-bottom: 16px;
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__heading {
      font-size: {{ s.mobile_heading_size }}px;
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__arrow {
      width: 36px;
      height: 36px;
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__track {
      grid-auto-columns: var(--mi-mobile-width);
      gap: var(--mi-mobile-gap);
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__body {
      padding: {{ s.mobile_content_padding }}px;
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__card-title {
      font-size: var(--mi-mobile-title-size);
      margin-bottom: 8px;
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__card-text,
    #miaora-benefits-{{ section.id }} .miaora-benefits__card-text * {
      font-size: var(--mi-mobile-text-size);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #miaora-benefits-{{ section.id }} .miaora-benefits__track {
      scroll-behavior: auto;
    }
    #miaora-benefits-{{ section.id }} .miaora-benefits__arrow,
    #miaora-benefits-{{ section.id }} .miaora-benefits__dot {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    var sectionId = 'miaora-benefits-{{ section.id }}';

    function initialize(root) {
      if (!root || root.dataset.miaoraInitialized === 'true') return;
      root.dataset.miaoraInitialized = 'true';

      var track = root.querySelector('[data-mi-track]');
      if (!track) return;
      var cards = Array.from(track.querySelectorAll('.miaora-benefits__card'));
      var previous = root.querySelector('[data-mi-prev]');
      var next = root.querySelector('[data-mi-next]');
      var dotsWrap = root.querySelector('[data-mi-dots]');
      var stops = [0];

      function buildStops() {
        var maximum = Math.max(0, track.scrollWidth - track.clientWidth);
        var firstLeft = cards.length ? cards[0].offsetLeft : 0;
        var positions = [0];
        cards.forEach(function (card) {
          var position = Math.max(0, Math.min(maximum, card.offsetLeft - firstLeft));
          if (Math.abs(position - positions[positions.length - 1]) > 4) positions.push(position);
        });
        if (maximum > 4 && Math.abs(maximum - positions[positions.length - 1]) > 4) positions.push(maximum);
        stops = positions;
        if (dotsWrap) {
          dotsWrap.innerHTML = '';
          stops.forEach(function (position, index) {
            var dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'miaora-benefits__dot';
            dot.setAttribute('aria-label', 'Aller à la position ' + (index + 1));
            dot.addEventListener('click', function () { moveTo(index); });
            dotsWrap.appendChild(dot);
          });
          dotsWrap.hidden = stops.length < 2;
        }
        update();
      }

      function currentIndex() {
        var nearest = 0;
        var distance = Infinity;
        stops.forEach(function (position, index) {
          var d = Math.abs(track.scrollLeft - position);
          if (d < distance) { distance = d; nearest = index; }
        });
        return nearest;
      }

      function update() {
        var index = currentIndex();
        if (previous) previous.disabled = index === 0;
        if (next) next.disabled = index >= stops.length - 1;
        if (dotsWrap) {
          Array.from(dotsWrap.children).forEach(function (dot, i) {
            if (i === index) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          });
        }
      }

      function moveTo(index) {
        index = Math.max(0, Math.min(stops.length - 1, index));
        track.scrollTo({ left: stops[index], behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }

      if (previous) previous.addEventListener('click', function () { moveTo(currentIndex() - 1); });
      if (next) next.addEventListener('click', function () { moveTo(currentIndex() + 1); });
      track.addEventListener('scroll', update, { passive: true });

      if ('ResizeObserver' in window) {
        var resizeObserver = new ResizeObserver(buildStops);
        resizeObserver.observe(track);
      } else {
        window.addEventListener('resize', buildStops);
      }

      root.addEventListener('shopify:block:select', function (event) {
        var card = event.target.closest('.miaora-benefits__card');
        if (!card) return;
        var firstLeft = cards.length ? cards[0].offsetLeft : 0;
        track.scrollTo({ left: card.offsetLeft - firstLeft, behavior: 'smooth' });
      });

      buildStops();
    }

    initialize(document.getElementById(sectionId));
    document.addEventListener('shopify:section:load', function (event) {
      initialize(event.target.querySelector('#' + sectionId));
    });
  })();
</script>

{% schema %}
{
  "name": "Miaora - Avantages",
  "settings": [
    { "type": "header", "content": "En-tête et navigation" },
    { "type": "text", "id": "heading", "label": "Titre au-dessus du slider (facultatif)" },
    { "type": "checkbox", "id": "show_arrows", "label": "Afficher les flèches", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Afficher les points de navigation", "default": true },

    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "section_background", "label": "Fond de la section", "default": "#FFFFFF" },
    { "type": "color", "id": "card_background", "label": "Fond des cartes", "default": "#F2F2F2" },
    { "type": "color", "id": "title_color", "label": "Couleur des titres", "default": "#050505" },
    { "type": "color", "id": "text_color", "label": "Couleur des descriptions", "default": "#6D6D6D" },
    { "type": "color", "id": "arrow_background", "label": "Fond des flèches", "default": "#F2F2F2" },
    { "type": "color", "id": "arrow_color", "label": "Couleur des flèches", "default": "#171717" },
    { "type": "color", "id": "accent_color", "label": "Couleur des points actifs", "default": "#151515" },

    { "type": "header", "content": "Mise en page ordinateur" },
    { "type": "range", "id": "max_width", "label": "Largeur maximale", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1120 },
    { "type": "range", "id": "gap_desktop", "label": "Espace entre les cartes", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_radius", "label": "Arrondi des cartes", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "content_padding", "label": "Marge intérieure des textes", "min": 12, "max": 44, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "image_ratio", "label": "Format des photos", "default": "17 / 10", "options": [
      { "value": "17 / 10", "label": "Paysage large (17:10)" },
      { "value": "16 / 9", "label": "Panoramique (16:9)" },
      { "value": "4 / 3", "label": "Paysage (4:3)" },
      { "value": "1 / 1", "label": "Carré" }
    ] },
    { "type": "select", "id": "image_fit", "label": "Ajustement des photos", "default": "cover", "options": [
      { "value": "cover", "label": "Remplir et recadrer" },
      { "value": "contain", "label": "Afficher l'image entière" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Espacement supérieur PC", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacement inférieur PC", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },

    { "type": "header", "content": "Typographie Manrope - PC" },
    { "type": "range", "id": "heading_size", "label": "Titre de la section", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "card_title_size", "label": "Titres des cartes", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 19 },
    { "type": "range", "id": "card_text_size", "label": "Descriptions", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "Version mobile" },
    { "type": "range", "id": "mobile_card_width", "label": "Largeur de carte en %", "min": 70, "max": 100, "step": 1, "unit": "%", "default": 86 },
    { "type": "range", "id": "gap_mobile", "label": "Espacement entre les cartes", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "mobile_content_padding", "label": "Marge intérieure des textes", "min": 12, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_heading_size", "label": "Titre de la section", "min": 18, "max": 36, "step": 1, "unit": "px", "default": 25 },
    { "type": "range", "id": "mobile_title_size", "label": "Titres des cartes", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 19 },
    { "type": "range", "id": "mobile_text_size", "label": "Descriptions", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "mobile_side_padding", "label": "Marges latérales de la section", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_padding_top", "label": "Espacement supérieur mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Espacement inférieur mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 30 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Carte avantage",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo de la carte (PC)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Photo mobile (facultative)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Un avantage Miaora" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Présentez ici un bénéfice de votre produit.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Miaora - Avantages",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Une litière toujours plus propre", "text": "<p>Miaora nettoie automatiquement après le passage de votre chat. Choisissez le mode <strong>automatique, programmé ou manuel</strong>, selon vos habitudes.</p>" } },
        { "type": "benefit", "settings": { "title": "Des odeurs mieux maîtrisées", "text": "<p>La <strong>triple désodorisation</strong> et le stérilisateur ionique aident à limiter les mauvaises odeurs dans votre intérieur.</p>" } },
        { "type": "benefit", "settings": { "title": "La sécurité de votre chat d'abord", "text": "<p>Des <strong>capteurs infrarouges</strong> détectent votre chat et arrêtent automatiquement le mécanisme lorsqu'une présence est repérée.</p>" } },
        { "type": "benefit", "settings": { "title": "Connectée à votre quotidien", "text": "<p>Depuis l'<strong>application Wi-Fi</strong> ou l'écran intégré, lancez un nettoyage, consultez les données et personnalisez les réglages.</p>" } },
        { "type": "benefit", "settings": { "title": "Un suivi du poids pratique", "text": "<p>Le <strong>capteur de poids intégré</strong> vous permet de suivre l'évolution du poids de votre chat et de remarquer d'éventuels changements.</p>" } },
        { "type": "benefit", "settings": { "title": "Jusqu'à 15 jours de tranquillité", "text": "<p>Avec son <strong>bac à déchets de 9 L</strong> et son espace intérieur de 65 L, Miaora réduit la fréquence des vidages (selon l'usage).</p>" } },
        { "type": "benefit", "settings": { "title": "Compatible avec vos litières", "text": "<p>Miaora accepte les litières <strong>tofu, mixtes, bentonite et minérales</strong>, pour conserver les habitudes de votre chat.</p>" } }
      ]
    }
